inherit cargo optfeature shell-completion

DESCRIPTION="Coding agent with the IDE wired in"
HOMEPAGE="https://omp.sh/ https://github.com/can1357/oh-my-pi"
SRC_URI="
	https://github.com/can1357/${PN}/archive/v${PV}.tar.gz -> ${P}.tar.gz
	https://github.com/WingsZeng/oh-my-pi-deps/releases/download/v${PV}/${P}-node-deps.tar.xz
	${CARGO_CRATE_URIS}
"

LICENSE="
	0BSD Apache-2.0 Apache-2.0-with-LLVM-exceptions BSD BSD-2 BlueOak-1.0.0
	Boost-1.0 BZIP2 CC-BY-4.0 CC0-1.0 GPL-3 ISC MIT MPL-2.0 PSF-2
	Unicode-3.0 ZLIB
"
SLOT="0"
KEYWORDS="~amd64"
RESTRICT="strip test"

# Rust 1.99 provides the required APIs; the patch drops the remaining const use.
# RUSTC_BOOTSTRAP enables upstream's crate-level feature gates.
BDEPEND="
	>=dev-lang/bun-bin-1.4.4
	dev-build/cmake
	virtual/pkgconfig
	>=dev-lang/rust-bin-1.99
"

PATCHES=(
	"${FILESDIR}"/${P}-relative-json-assets.patch
	"${FILESDIR}"/${P}-stable-rust.patch
)

pkg_setup() {
	local rust_atom=$(best_version -b '>=dev-lang/rust-bin-1.99')
	local rust_slot=${rust_atom#dev-lang/rust-bin-}

	[[ -n ${rust_slot} ]] || die "Rust 1.99 or newer is required"
	rust_prepend_path "${rust_slot}" binary
}

src_unpack() {
	cargo_src_unpack
}

src_configure() {
	cargo_gen_config
	cargo_src_configure --frozen --package pi-natives --profile ci --ignore-rust-version
}

src_compile() {
	local -x CMAKE_POLICY_VERSION_MINIMUM=3.5
	local -x RUSTC_BOOTSTRAP=1
	local -x RUSTFLAGS="${RUSTFLAGS} -C target-cpu=x86-64-v2"

	cargo_env cargo build "${ECARGO_ARGS[@]}" || die
	cp target/ci/libpi_natives.so \
		packages/natives/native/pi_natives.linux-x64-baseline.node || die
	bun scripts/stamp-native-version.ts \
		packages/natives/native/pi_natives.linux-x64-baseline.node || die
	bun --cwd=packages/coding-agent run build || die
}

src_install() {
	local -x HOME="${T}/home"
	local -x XDG_DATA_HOME="${T}/share"
	local omp=packages/coding-agent/dist/omp

	mkdir -p "${HOME}" "${XDG_DATA_HOME}" || die
	dobin "${omp}"

	"${omp}" completions bash > "${T}"/omp.bash || die
	"${omp}" completions fish > "${T}"/omp.fish || die
	"${omp}" completions zsh > "${T}"/_omp || die
	newbashcomp "${T}"/omp.bash omp
	newfishcomp "${T}"/omp.fish omp.fish
	newzshcomp "${T}"/_omp _omp

	dodoc README.md packages/{coding-agent,natives}/THIRD-PARTY-NOTICES.txt
}

pkg_postinst() {
	optfeature "ALSA voice support" media-libs/alsa-lib
	optfeature "PulseAudio or PipeWire voice support" media-libs/libpulse
	optfeature "browser tool" www-client/google-chrome
	optfeature "Git integration and isolated worktrees" dev-vcs/git
	optfeature "Julia eval backend" dev-lang/julia-bin
	optfeature "Python eval backend" dev-lang/python
}
